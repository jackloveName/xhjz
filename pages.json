	"tabBar": {
		"color": "#5e6673",
		"selectedColor": "#101722",
		"borderStyle": "white",
		"backgroundColor": "#ffffff",
		"list": [{
			"pagePath": "pages/index",
			"iconPath": "static/images/tabbar/book.png",
