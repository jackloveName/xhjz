			"navigationBarTitleText": "设置"
		}
	},{
		"path": "pages/mine/terms/index",
		"style": {
			"navigationBarTitleText": ""
		}
	},{
		"path": "pages/mine/change-password/index",
		"style": {
			"navigationBarTitleText": "修改密码"
		}
	},{
		"path": "pages/mine/cancel-account/index",
